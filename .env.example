# =============================================================
# Vivent académico — variables de entorno de ejemplo
# Copiar como .env y ajustar. NO incluir credenciales reales.
# =============================================================

# --- Backend (Spring Boot) ---
VIVENT_DB_URL=jdbc:postgresql://localhost:5433/vivent
VIVENT_DB_USERNAME=vivent
VIVENT_DB_PASSWORD=vivent

# JWT (producción académica: cambiar por valores propios)
# El backend usa valores por defecto de desarrollo si no se definen.

# --- Frontend (Next.js) ---
NEXT_PUBLIC_API_BASE_URL=http://localhost:8080
NEXT_PUBLIC_DEFAULT_TENANT=demo

# --- Integraciones externas (APIs reales) ---
VIVENT_INTEGRATIONS_OPENFOODFACTS_BASE_URL=https://world.openfoodfacts.org
VIVENT_INTEGRATIONS_PHOTON_BASE_URL=https://photon.komoot.io
VIVENT_INTEGRATIONS_EXCHANGERATE_BASE_URL=https://open.er-api.com

# --- Panel master SaaS (OPCIONAL en local; omitir si no se usa) ---
# VIVENT_PLATFORM_BOOTSTRAP_ENABLED=true
# VIVENT_PLATFORM_BOOTSTRAP_USERNAME=platform
# VIVENT_PLATFORM_BOOTSTRAP_PASSWORD=ChangeMe123!
